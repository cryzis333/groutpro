# Переменные окружения backend ГраутПро — шаблон без настоящих секретов.
#
# Локально: cp backend/.env.example .env  (в корне репозитория, запуск оттуда же).
# На сервере значения лежат в /etc/groutpro.env (EnvironmentFile сервиса groutpro.service).
# Ключи из secrets/notify.env (см. NOTIFY_ENV_FILE) переопределяют любые значения отсюда.
# Файлы с настоящими паролями и ключами в git не добавлять.

# ---------- Обязательные ----------

# PostgreSQL. Спецсимволы в пароле кодируются для URL (/ -> %2F, @ -> %40).
DATABASE_URL=postgres://groutpro:change-me@127.0.0.1:5432/groutpro

# Подпись токенов админки. Пустое значение — backend не запустится.
# Нужна длинная случайная строка: openssl rand -hex 32
JWT_SECRET=

ADMIN_USERNAME=admin

# bcrypt-хэш пароля админки: htpasswd -nBC 12 admin | cut -d: -f2 | sed 's/^\$2y\$/$2b$/'
# В .env — в одинарных кавычках, иначе $… будет принято за переменную.
ADMIN_PASSWORD_HASH='$2b$12$replace.with.a.real.bcrypt.hash'

# ---------- Сайт ----------

# Адрес сайта без «/» в конце: возврат после оплаты, ссылки в уведомлениях, CORS.
# Пусто — онлайн-оплата и ссылки в уведомлениях выключены.
SITE_URL=https://serious-company.ru

# Backend слушает только локальный адрес, наружу его открывает nginx (/api/, /health).
# 0.0.0.0 — только внутри контейнера.
SERVER_HOST=127.0.0.1
SERVER_PORT=3100

# Каталог фото товаров. На сервере: /srv/apps/groutpro-next/uploads
# (из-за ProtectSystem=strict другие каталоги сервису недоступны для записи).
UPLOAD_DIR=uploads

# ---------- ЮKassa (необязательно) ----------
# Без обоих значений онлайн-оплата выключена; счета для организаций и заявки работают.
# Адрес HTTP-уведомлений в кабинете ЮKassa: https://<домен>/api/payments/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------- Уведомления о заявках и заказах (любой канал можно оставить пустым) ----------

# Telegram: токен бота от @BotFather, id чатов через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
# Прокси, если api.telegram.org недоступен напрямую, например socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# MAX: токен бота и id чата.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_BASE=https://platform-api.max.ru

# Почта (SSL). Для Яндекса нужен пароль приложения, а не пароль от ящика.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Отправитель; пусто — как SMTP_USER.
SMTP_FROM=
# Получатели уведомлений через запятую.
ADMIN_EMAIL=

# ---------- Прочее ----------

# Прибавка к числу выполненных объектов в GET /api/stats.
STATS_OBJECTS_BASE=10
# Файл с переопределениями (путь от рабочего каталога сервиса).
NOTIFY_ENV_FILE=secrets/notify.env
